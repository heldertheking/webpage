# Copy relevant values into .env.development / .env.production / .env.local as needed.
# Vite only exposes variables prefixed with VITE_ to client code.

# Portainer status webhook — powers the live infra badges in the Highlight section.
VITE_PORTAINER_STATUS_ENDPOINT=https://automation.heldertheking.com/webhook/portainerStatus

# Contact form submission endpoint. Leave unset to just log payloads locally.
VITE_CONTACT_ENDPOINT=

# Github username for project links
VITE_GITHUB_USERNAME=heldertheking
